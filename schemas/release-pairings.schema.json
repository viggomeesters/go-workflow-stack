{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable Go release pairings",
  "type": "object",
  "required": [
    "schema",
    "current_stack_ref",
    "template_repository",
    "pairings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "go-workflow.release-pairings.v1"
    },
    "current_stack_ref": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "template_repository": {
      "const": "https://github.com/viggomeesters/go-project-template.git"
    },
    "pairings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stack_ref",
          "template_commit",
          "template_ref",
          "note"
        ],
        "properties": {
          "stack_ref": {
            "type": "string",
            "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "template_commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "template_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
