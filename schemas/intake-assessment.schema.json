{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-workflow.intake-assessment.v1",
  "title": "Bounded semantic intake assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_sha256",
    "summary",
    "disposition",
    "actions",
    "questions",
    "relevant_decisions"
  ],
  "properties": {
    "schema": {"const": "go-workflow.intake-assessment.v1"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["ready", "questions", "research_first"]},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    },
    "questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    },
    "relevant_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {"$ref": "#/$defs/strings"},
        "after": {"$ref": "#/$defs/strings"},
        "states": {"$ref": "#/$defs/strings"},
        "edges": {"$ref": "#/$defs/strings"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "modify"],
      "properties": {
        "read": {"$ref": "#/$defs/strings"},
        "modify": {"$ref": "#/$defs/strings"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action", "task_id", "summary", "work_type", "root_cause", "substantial",
        "outcome_ids", "scope", "behavior", "non_goals", "dependencies",
        "delegated_choices", "question_ids", "acceptance", "verification"
      ],
      "properties": {
        "action": {"enum": ["create", "reuse", "update"]},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "summary": {"type": "string", "minLength": 1},
        "work_type": {"enum": ["implementation", "bug_fix", "research"]},
        "root_cause": {"enum": ["known", "unknown", "not_applicable"]},
        "substantial": {"type": "boolean"},
        "outcome_ids": {"$ref": "#/$defs/strings"},
        "scope": {"$ref": "#/$defs/scope"},
        "behavior": {"$ref": "#/$defs/behavior"},
        "non_goals": {"$ref": "#/$defs/strings"},
        "dependencies": {"type": "array", "items": {"type": "object"}},
        "delegated_choices": {"$ref": "#/$defs/strings"},
        "question_ids": {"$ref": "#/$defs/strings"},
        "acceptance": {"$ref": "#/$defs/strings"},
        "verification": {"$ref": "#/$defs/strings"}
      },
      "allOf": [
        {
          "if": {"properties": {"substantial": {"const": true}}},
          "then": {
            "properties": {
              "behavior": {
                "required": ["before", "after", "states", "edges"],
                "properties": {
                  "before": {"minItems": 1},
                  "after": {"minItems": 1},
                  "states": {"minItems": 1},
                  "edges": {"minItems": 1}
                }
              },
              "non_goals": {"minItems": 1},
              "acceptance": {"minItems": 1},
              "verification": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "root_cause": {"const": "unknown"}
            },
            "required": ["root_cause"]
          },
          "then": {"properties": {"work_type": {"const": "research"}}}
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "owner", "blocks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "text": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "blocks": {"$ref": "#/$defs/strings"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]}
      }
    }
  }
}
