{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-workflow.execution-brief.v1",
  "title": "Go Workflow Execution Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "destination",
    "problem",
    "chosen_approach",
    "non_goals",
    "source",
    "work_units"
  ],
  "properties": {
    "schema": {"const": "go-workflow.execution-brief.v1"},
    "destination": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "chosen_approach": {"type": "string", "minLength": 1, "maxLength": 2000},
    "non_goals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "sha256", "source_ref"],
      "properties": {
        "recommendation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_ref": {"type": ["string", "null"]}
      }
    },
    "work_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "scope", "execution_mode", "acceptance", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "summary": {"type": "string", "minLength": 1},
          "execution_mode": {"enum": ["mechanical", "agent"]},
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["read", "modify"],
            "properties": {
              "read": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "modify": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
