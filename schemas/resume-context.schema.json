{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative resume context",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "task_status",
    "phase",
    "completed",
    "next_action",
    "summary",
    "source_records",
    "blockers"
  ],
  "properties": {
    "schema": {
      "const": "go-workflow.resume-context.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_status": {
      "enum": [
        "open",
        "active",
        "blocked",
        "done"
      ]
    },
    "phase": {
      "type": "string"
    },
    "completed": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "source_records": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
