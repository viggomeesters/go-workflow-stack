{
  "schema": "go-workflow.repo-local.project.v1",
  "kind": "project",
  "id": "go-workflow-stack",
  "name": "Go Workflow Stack",
  "source_of_truth": "repo-local",
  "project_mode": "project",
  "required_stack_version": "0.3.48",
  "stack_ref": "v0.3.48",
  "default_verification": [
    "uv run --no-project --with pytest pytest -q",
    "make check"
  ],
  "links": {
    "repo": ""
  },
  "contract_version": 2,
  "release_profiles": {
    "github-release": {
      "provider": "github-release",
      "remote": "origin",
      "branch": "main",
      "repository": "viggomeesters/go-workflow-stack",
      "publication": {
        "version": {
          "path": "pyproject.toml",
          "format": "toml",
          "key": "project.version"
        },
        "bump": "patch",
        "tag_prefix": "v",
        "changelog": "CHANGELOG.md"
      }
    }
  }
}
