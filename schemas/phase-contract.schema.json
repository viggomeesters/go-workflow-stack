{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-workflow.phase-contract.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "go-workflow.phase-contract.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "modify"
      ],
      "properties": {
        "read": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "modify": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "handoff": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "required_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "scope",
    "inputs",
    "outputs",
    "required_evidence",
    "stop_conditions",
    "handoff",
    "required_outcomes"
  ]
}
