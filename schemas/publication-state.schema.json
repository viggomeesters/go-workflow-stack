{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable task publication intent and exact readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "base_commit",
    "contract_digest",
    "control_repo",
    "effects",
    "notes",
    "observations",
    "owner",
    "phase",
    "preparation",
    "profile",
    "project",
    "remote_base",
    "remote_url",
    "reservation",
    "run_id",
    "schema",
    "tag",
    "task_id",
    "version",
    "workspace"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "control_repo": {
      "type": "string",
      "minLength": 1
    },
    "remote_url": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "reservation": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "remote_base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tag_object": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema": {
      "const": "go-workflow.publication-state.v1"
    },
    "workspace": {
      "type": "object"
    },
    "profile": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "required": [
        "ship_policy",
        "allow_push",
        "actor"
      ],
      "additionalProperties": false,
      "properties": {
        "ship_policy": {
          "const": "push"
        },
        "allow_push": {
          "const": true
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "object",
          "required": [
            "allowed",
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "const": true
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "phase": {
      "enum": [
        "preparing",
        "prepared",
        "publishing",
        "deploying",
        "finishing",
        "published",
        "suspended"
      ]
    },
    "preparation": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path",
          "before",
          "after"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.(?:go|git)(?:/|$))[^\\r\\n\\u0000]+$"
          },
          "before": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "after": {
            "type": "string"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected",
          "status"
        ],
        "properties": {
          "expected": {},
          "status": {
            "enum": [
              "pending",
              "confirmed"
            ]
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect",
          "observed"
        ],
        "properties": {
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "observed": {}
        }
      }
    },
    "release_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "key",
        "phase",
        "commands",
        "observations",
        "artifact",
        "package_attempts"
      ],
      "properties": {
        "schema": {
          "const": "go-workflow.deployment-state.v1"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "target",
            "recovery_policy",
            "required_env",
            "deploy",
            "observe"
          ],
          "properties": {
            "mode": {
              "const": "required"
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "recovery_policy": {
              "const": "resume_only"
            },
            "required_env": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "deploy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "idempotency"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "\\{idempotency_key\\}"
                  }
                },
                "idempotency": {
                  "const": "required"
                }
              }
            },
            "observe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "read_only"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "\\{idempotency_key\\}"
                  }
                },
                "read_only": {
                  "const": true
                }
              }
            },
            "package": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "filename"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "\\{output\\}"
                  }
                },
                "filename": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              }
            }
          }
        },
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "phase": {
          "enum": [
            "pending",
            "accepted",
            "verified"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "observation",
              "raw"
            ],
            "additionalProperties": false,
            "properties": {
              "observation": {
                "type": "object",
                "required": [
                  "schema",
                  "status",
                  "authorized",
                  "available",
                  "target",
                  "commit",
                  "version",
                  "artifact_sha256",
                  "idempotency_key"
                ],
                "properties": {
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                  },
                  "artifact_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "idempotency_key": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "schema": {
                    "const": "go-workflow.deployment-observation.v1"
                  },
                  "status": {
                    "enum": [
                      "absent",
                      "accepted",
                      "live",
                      "unknown"
                    ]
                  },
                  "authorized": {
                    "type": "boolean"
                  },
                  "available": {
                    "type": "boolean"
                  }
                }
              },
              "raw": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "artifact": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "size"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "package_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "output",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "output": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pending",
                  "confirmed"
                ]
              }
            }
          }
        },
        "effect": {
          "type": "object",
          "required": [
            "status",
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "confirmed"
              ]
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "commit",
                "version",
                "artifact_sha256",
                "idempotency_key"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                },
                "artifact_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "idempotency_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision",
        "digest",
        "history"
      ],
      "properties": {
        "schema": {
          "const": "go-workflow.release-candidate.v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "digest"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reason",
        "checkpoint_sha256",
        "candidate_digest",
        "workspace_head"
      ],
      "properties": {
        "schema": {
          "const": "go-workflow.release-suspension.v1"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workspace_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "suspended"
          }
        }
      },
      "then": {
        "required": [
          "suspension"
        ],
        "properties": {
          "effects": {
            "maxProperties": 0
          },
          "observations": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "commit"
              ]
            },
            {
              "required": [
                "tag_object"
              ]
            },
            {
              "required": [
                "release_evidence"
              ]
            },
            {
              "required": [
                "deployment"
              ]
            }
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "suspension"
          ]
        }
      }
    }
  ]
}
