{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit release identity and optional publication settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "remote",
    "branch"
  ],
  "properties": {
    "provider": {
      "enum": [
        "git-tag",
        "github-release"
      ]
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "bump",
        "tag_prefix",
        "changelog"
      ],
      "properties": {
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.(?:go|git)(?:/|$))[^\\r\\n\\u0000]+$"
            },
            "format": {
              "enum": [
                "text",
                "json"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "json"
                  }
                }
              },
              "then": {
                "required": [
                  "key"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "key"
                  ]
                }
              }
            }
          ]
        },
        "bump": {
          "enum": [
            "major",
            "minor",
            "patch"
          ]
        },
        "tag_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]*$"
        },
        "changelog": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.(?:go|git)(?:/|$))[^\\r\\n\\u0000]+$"
        }
      }
    },
    "deployment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "reason"
          ],
          "properties": {
            "mode": {
              "const": "none"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "target",
            "recovery_policy",
            "required_env",
            "deploy",
            "observe"
          ],
          "properties": {
            "mode": {
              "const": "required"
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "recovery_policy": {
              "const": "resume_only"
            },
            "required_env": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "deploy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "idempotency"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "\\{idempotency_key\\}"
                  }
                },
                "idempotency": {
                  "const": "required"
                }
              }
            },
            "observe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "read_only"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "\\{idempotency_key\\}"
                  }
                },
                "read_only": {
                  "const": true
                }
              }
            },
            "package": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "filename"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "\\{output\\}"
                  }
                },
                "filename": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "github-release"
          }
        }
      },
      "then": {
        "required": [
          "repository"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "git-tag"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "repository"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "deployment"
        ],
        "properties": {
          "deployment": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "required"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "publication"
        ]
      }
    }
  ]
}
