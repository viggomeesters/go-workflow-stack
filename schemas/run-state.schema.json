{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed task phase checkpoint",
  "type": "object",
  "required": [
    "task_id",
    "project",
    "control_repo",
    "owner",
    "run_id",
    "task_hash",
    "schema",
    "phase",
    "attempt",
    "check_index",
    "worker_group",
    "inflight",
    "controller",
    "workspace",
    "models",
    "effects",
    "code",
    "checks",
    "phase_evidence",
    "budgets",
    "history",
    "requirements"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "control_repo": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_hash": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "go-workflow.managed-run.v1"
    },
    "phase": {
      "enum": [
        "setup",
        "build",
        "release_prepare",
        "verify",
        "critic",
        "repair",
        "release",
        "cleanup",
        "complete"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "check_index": {
      "type": "integer",
      "minimum": 0
    },
    "worker_group": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "inflight": {
      "type": [
        "object",
        "null"
      ]
    },
    "controller": {
      "type": "object",
      "required": [
        "host",
        "pid"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object"
    },
    "models": {
      "type": "object"
    },
    "effects": {
      "type": "object"
    },
    "code": {
      "type": "object"
    },
    "checks": {
      "type": "array"
    },
    "phase_evidence": {
      "type": "array"
    },
    "budgets": {
      "type": "array"
    },
    "history": {
      "type": "array"
    },
    "requirements": {
      "type": "array"
    },
    "cleanup": {
      "type": "object"
    },
    "setup_task": {
      "type": "object"
    },
    "execution_cwd": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "ship_policy",
        "allow_push"
      ],
      "properties": {
        "profile": {
          "type": [
            "object",
            "null"
          ]
        },
        "ship_policy": {
          "enum": [
            "none",
            "push",
            "commit"
          ]
        },
        "allow_push": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": false
}
