{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-workflow.verification-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "task_id",
    "phase_id",
    "requirement_ids"
  ],
  "properties": {
    "schema": {
      "const": "go-workflow.verification-evidence.v1"
    },
    "status": {
      "enum": [
        "missing",
        "failed",
        "not_applicable",
        "passed"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "worktree_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "exit_code": {
      "type": "integer"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_applicable"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "command",
          "cwd",
          "revision",
          "worktree_digest",
          "exit_code",
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "not": {
              "const": 0
            }
          }
        }
      }
    }
  ]
}
