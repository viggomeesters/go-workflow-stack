{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-workflow.behavior-review.v1",
  "title": "Go Workflow Grounded Behavior Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "context_digest",
    "candidate_digest",
    "acceptance_digest",
    "status",
    "outcomes",
    "repairs",
    "publication_pending"
  ],
  "properties": {
    "schema": {"const": "go-workflow.behavior-review.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["passed", "blocked"]},
    "publication_pending": {"type": "boolean"},
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "rationale", "evidence"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "blocked", "pending_downstream"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "role", "path", "sha256", "task_id", "requirement_id", "candidate_digest", "context_digest", "observation"],
              "properties": {
                "kind": {"enum": ["source", "test_result", "runtime_observation", "browser_capture", "visual_capture", "audio_capture"]},
                "role": {"enum": ["behavior_proof", "preparation", "unrelated", "claim_only"]},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "task_id": {"type": "string", "minLength": 1},
                "requirement_id": {"type": "string", "minLength": 1},
                "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "observation": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "action", "paths", "verification", "acceptance_digest"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
